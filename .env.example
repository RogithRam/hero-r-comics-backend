# Copy this file to .env for local testing (never commit the real .env).
# In Render/Railway/Fly.io, set these as environment variables in the
# dashboard instead of uploading this file.

# From https://replicate.com/account/api-tokens (sign up, then create a token)
REPLICATE_API_TOKEN=

# Optional — only set these if you want to use a different model than
# google/nano-banana-pro (the default baked into server.js).
# REPLICATE_MODEL_OWNER=google
# REPLICATE_MODEL_NAME=nano-banana-pro

PORT=3000
